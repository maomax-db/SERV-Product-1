# ---------------------------------------------------------------------------
# SERV Guardrail — environment configuration (Robinhood Chain edition)
# Copy this file to `.env` (git-ignored) and fill in your real values.
#   PowerShell:   Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# ---- OpenServ / SERV Reasoning --------------------------------------------
# Register at https://console.openserv.ai, then create an API key.
# The SERV Reasoning API is OpenAI Chat Completions wire-compatible — this
# repo talks to it over plain HTTP with a Bearer token.
OPENSERV_API_KEY=sk-your-key-here

# Inference endpoint (OpenAI-format base URL). Override only if you must.
OPENSERV_BASE_URL=https://inference-api.openserv.ai/v1

# Default model for SERV calls. Cheap-and-good default; override per call.
OPENSERV_MODEL=gpt-5.4-mini

# ---- Project wallet (Robinhood Chain) --------------------------------------
# This repo trades directly on-chain with a plain EVM wallet — no brokerage
# account, no OAuth, no MCP credential involved anywhere. Generate a fresh
# wallet and put its private key in this line ONLY:
#   python -c "from web3 import Web3; print(Web3().eth.account.create().key.hex())"
# NEVER commit, print, or log this key. 0x-prefix hex, 64 chars.
PRIVATE_KEY=

# ---- Robinhood Chain networks (defaults below; override if you must) -------
# Testnet is the primary dev target. Mainnet exists only for the final,
# small-amount live-swap demo (1inch/Uniswap routing is mainnet-only — see README).
ROBINHOOD_RPC_TESTNET=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID_TESTNET=46630
ROBINHOOD_RPC_MAINNET=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID_MAINNET=4663